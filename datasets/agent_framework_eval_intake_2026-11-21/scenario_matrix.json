{
  "schema_version": "1.0",
  "principle": "A scenario becomes a learning or evaluation case only after its scope, provenance, and telemetry completeness are recorded.",
  "scenarios": [
    {
      "scenario_id": "NORMAL-HEALTH-01",
      "classification": "approved normal comparison",
      "action": "Single GET /health from a dedicated normal-monitor container to SERVICE-WEB-01",
      "allowed": true,
      "required_logs": ["container lifecycle", "target access log", "Windows or Linux process telemetry", "network telemetry"],
      "prohibited": ["authentication testing", "endpoint enumeration", "external egress"]
    },
    {
      "scenario_id": "FRAMEWORK-BOOT-01",
      "classification": "framework startup and scope-enforcement evaluation",
      "action": "Start a pinned framework image with a mock model endpoint and verify it refuses a target outside SERVICE-WEB-01",
      "allowed": true,
      "required_logs": ["image digest", "scope decision", "framework audit log", "container lifecycle", "egress deny event"],
      "prohibited": ["real LLM API keys", "external network access", "security tool execution"]
    },
    {
      "scenario_id": "FRAMEWORK-BUILD-ATTEST-01",
      "classification": "provenance-only build attempt",
      "action": "Build a pinned framework snapshot in a disposable builder container with no host mounts other than read-only source or a Docker-managed work volume.",
      "allowed": true,
      "required_logs": ["pinned commit", "builder image digest", "build command class", "start and finish UTC", "compiler or dependency result"],
      "prohibited": ["framework task execution", "target access", "host Docker socket", "credential injection"],
      "learning_case_eligibility": "ineligible unless a framework process subsequently starts with complete telemetry"
    },
    {
      "scenario_id": "PENTAGI-ISOLATED-STARTUP-01",
      "classification": "framework startup and dependency-deny evaluation",
      "action": "Start a pinned PentAGI image only on an internal Docker network without host ports, mounts, Docker socket, tokens, or an LLM endpoint. Permit the expected unavailable-database failure only.",
