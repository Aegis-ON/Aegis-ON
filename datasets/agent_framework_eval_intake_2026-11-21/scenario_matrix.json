      "required_logs": ["image revision or digest", "container lifecycle", "container stdout or stderr", "network topology", "resource and capability restrictions"],
      "prohibited": ["database provisioning", "API or GraphQL exposure", "flow creation", "agent task execution", "external egress"],
      "learning_case_eligibility": "telemetry validation only; security-team review required before any behavioral label"
    },
    {
